# --- Seed an editable, host-persisted provider config (no secrets shipped) ----
if [ ! -f "$HOME/.hindsight/server.env" ]; then
    cat >"$HOME/.hindsight/server.env" <<'EOF'
# Hindsight server configuration. This file lives on the hindsight-data mount,
# so it persists across workshop updates — configure it once.
#
# By default Hindsight runs without its own LLM. This is the right mode when a
# client such as Hermes owns the conversational LLM and uses Hindsight as its
# memory backend. Retain stores chunks, recall works, and LLM-only Hindsight
# operations such as reflect/mental-model refresh are unavailable until you
# configure a provider below.
HINDSIGHT_API_LLM_PROVIDER=none
HINDSIGHT_API_LLM_MODEL=none
HINDSIGHT_API_WORKER_ID=hindsight-workshop

# Optional: use a keyless local provider reached via the `llm-endpoint` tunnel
# (e.g. a host Ollama):
#   HINDSIGHT_API_LLM_PROVIDER=ollama
#   HINDSIGHT_API_LLM_BASE_URL=http://127.0.0.1:11434/v1
#   HINDSIGHT_API_LLM_MODEL=gemma3:12b
#
# Or use a cloud provider instead:
#   HINDSIGHT_API_LLM_PROVIDER=openai
#   HINDSIGHT_API_LLM_API_KEY=sk-...
#   HINDSIGHT_API_LLM_MODEL=gpt-4o-mini
EOF
fi

# --- systemd user services ----------------------------------------------------
install -D --mode=644 --target-directory "$HOME/.config/systemd/user" \
    "$SDK/hindsight-api.service" "$SDK/hindsight-control-plane.service"
systemctl --user daemon-reload
systemctl --user enable --now hindsight-api.service hindsight-control-plane.service
