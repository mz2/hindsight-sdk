if ! sudo -u workshop --login command -v hindsight-api >/dev/null 2>&1; then
    workshopctl set-health error "hindsight-api is not installed; check the setup-project hook output"
    exit 0
fi

if ! sudo -u workshop --login command -v hindsight-control-plane >/dev/null 2>&1; then
    workshopctl set-health error "hindsight-control-plane is not installed; check the SDK build output"
    exit 0
fi

# The API serves /health on :8888 once embedded Postgres is ready. With
# HINDSIGHT_API_LLM_PROVIDER=none this does not require a model; Hindsight can
# run as a chunk/recall memory backend for clients such as Hermes.
for _ in $(seq 1 20); do
    if curl -fsS -o /dev/null --max-time 3 http://127.0.0.1:8888/health 2>/dev/null; then
        msg="Hindsight API -> http://localhost:8888"
        if curl -fsS -o /dev/null --max-time 3 http://127.0.0.1:9999 2>/dev/null; then
            msg="$msg  |  Control Plane -> http://localhost:9999"
        fi
        echo -n "$msg"
        workshopctl set-health okay
        exit 0
    fi
    sleep 3
done

systemctl status --user hindsight-api.service || true
workshopctl set-health waiting "Hindsight API not responding yet"
