[Unit]
Description=Hindsight Control Plane
After=hindsight-api.service network-online.target
Wants=hindsight-api.service network-online.target

[Service]
Type=simple
Environment=PORT=9999
Environment=HINDSIGHT_CP_DATAPLANE_API_URL=http://127.0.0.1:8888
ExecStart=/bin/bash -lc 'exec /var/lib/workshop/sdk/hindsight/bin/hindsight-control-plane'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
